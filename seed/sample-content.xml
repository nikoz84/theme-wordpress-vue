    <item>
      <title>Editing the theme locally</title>
      <link>http://localhost:8080/?p=3</link>
      <pubDate>Mon, 06 Oct 2026 12:10:00 +0000</pubDate>
      <dc:creator><![CDATA[admin]]></dc:creator>
      <guid isPermaLink="false">http://localhost:8080/?p=3</guid>
      <description></description>
      <content:encoded><![CDATA[<p>The Docker testing environment mounts the repo root into the WordPress container, so edits to PHP, CSS, or JS files reflect on the next browser refresh with no rebuild.</p>]]></content:encoded>
      <excerpt:encoded><![CDATA[Edits to theme files flow straight through to the browser.]]></excerpt:encoded>
