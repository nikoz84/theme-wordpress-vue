# Copy this file to .env and edit the two WP_*_PASSWORD values.
# .env is gitignored; .env.example is the committed reference.
#
# Per FR-008: the two passwords below are TEST-ONLY placeholders.
# They MUST be replaced before exposing the site to anyone else.

# ---- Host port ----
# Non-privileged port (>= 1024) per FR-013. Default: 8080.
HOST_PORT=8080

# ---- WordPress admin ----
WP_ADMIN_USER=admin
# TEST-ONLY placeholder. Replace before sharing the environment.
WP_ADMIN_PASSWORD=change-me-locally-admin
WP_ADMIN_EMAIL=admin@example.test
WP_SITE_TITLE=Vue Blocks (local)

# ---- Database ----
WP_DB_HOST=db
WP_DB_USER=wordpress
# TEST-ONLY placeholder. Replace before sharing the environment.
WP_DB_PASSWORD=change-me-locally-db
WP_DB_NAME=wordpress